OTP_EXPIRE_MINUTES=10
OTP_RESEND_COOLDOWN_SECONDS=60
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true
